{
  "name": "kts-wool-inventory",
  "private": true,
  "version": "1.0.0",
  "description": "Wool stock inventory system for Kumbeshwar Technical School",
  "author": "Kumbeshwar Technical School",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"electron .\"",
    "build": "tsc && vite build",
    "rebuild": "electron-rebuild -f -w sqlite3",
    "postinstall": "electron-rebuild -f -w sqlite3",
    "dist": "npm run build && electron-builder --win"
  },
 "build": {
    "appId": "com.kts.wool-inventory",
    "productName": "KTS Wool Inventory",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KTS Wool Inventory"
    }
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.10.9",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sqlite3": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sqlite3": "^3.1.11",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}